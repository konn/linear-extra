cabal-version: 3.4
name: linear-fft
version: 0.1.0.0
description: Please see the README on GitHub at <https://github.com/konn/linear-fft#readme>
homepage: https://github.com/konn/linear-fft#readme
bug-reports: https://github.com/konn/linear-fft/issues
author: Hiromi ISHII
maintainer: konn.jinro_at_gmail.com
copyright: 2023 (c) Hiromi ISHII
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
extra-source-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/konn/linear-fft

common defaults
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

  other-modules: Paths_linear_fft
  autogen-modules: Paths_linear_fft
  default-language: GHC2021

library
  import: defaults
  -- cabal-gild: discover src --exclude=src/**/Internal.hs
  exposed-modules:
    Numeric.FFT.App
    Numeric.FFT.App.Csv
    Numeric.FFT.CooleyTukey.Linear

  -- cabal-gild: discover src --include=src/**/Internal.hs
  other-modules:
  hs-source-dirs: src
  build-depends:
    base >=4.7 && <5,
    cassava,
    deepseq,
    directory,
    filepath,
    fmlist,
    integer-logarithms,
    linear-array-extra,
    linear-base,
    linear-generics,
    linear-memory,
    linear-parallel,
    linear-witness,
    optparse-applicative,
    reflection,
    streaming,
    vector,

executable linear-fft
  import: defaults
  main-is: linear-fft.hs
  hs-source-dirs: app
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints
    -threaded
    -rtsopts
    "-with-rtsopts=-N --nonmoving-gc"
    -eventlog

  build-depends:
    base >=4.7 && <5,
    deepseq,
    linear-fft,
    vector,

test-suite linear-fft-test
  import: defaults
  type: exitcode-stdio-1.0
  main-is: Main.hs
  -- cabal-gild: discover test --exclude=test/Main.hs
  other-modules: Numeric.FFT.CooleyTukey.LinearSpec
  hs-source-dirs: test
  ghc-options:
    -threaded
    -O2
    -rtsopts
    "-with-rtsopts=-N --nonmoving-gc"

  build-tool-depends: tasty-discover:tasty-discover
  build-depends:
    base >=4.7 && <5,
    deepseq,
    falsify,
    linear-fft,
    tasty,
    vector,

benchmark linear-fft-bench
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is: bench.hs
  -- cabal-gild: discover bench --exclude=bench/bench.hs
  other-modules:
  ghc-options:
    -threaded
    -rtsopts
    -O2
    "-with-rtsopts=-N1 --nonmoving-gc"

  build-depends:
    base >=4.7 && <5,
    deepseq,
    linear-fft,
    tasty,
    tasty-bench,
    vector,
