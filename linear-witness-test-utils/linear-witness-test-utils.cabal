cabal-version: 3.4
name: linear-witness-test-utils
version: 0.1.0.0
description: Please see the README on GitHub at <https://github.com/konn/linear-witness-test#readme>
homepage: https://github.com/konn/linear-witness-test#readme
bug-reports: https://github.com/konn/linear-witness-test/issues
author: Hiromi ISHII
maintainer: konn.jinro_at_gmail.com
copyright: 2023 (c) Hiromi ISHII
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
extra-source-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/konn/linear-witness-test

common defaults
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

  other-modules: Paths_linear_witness_test_utils
  autogen-modules: Paths_linear_witness_test_utils
  default-language: GHC2021

library
  import: defaults
  -- cabal-gild: discover src
  exposed-modules: Linear.Token.Linearly.TestUtils
  hs-source-dirs: src
  build-depends:
    base >=4.7 && <5,
    containers,
    dlist,
    falsify,
    foldl,
    linear-base,
    linear-witness,
    tasty,
    tasty-hunit,
    vector,

test-suite linear-witness-test
  import: defaults
  type: exitcode-stdio-1.0
  main-is: Main.hs
  -- cabal-gild: discover test --exclude=test/Main.hs
  other-modules:
    Data.Array.Mutable.Linear.WitnessSpec
    Data.HashMap.Mutable.Linear.WitnessSpec
    Data.Set.Mutable.Linear.WitnessSpec
    Data.Vector.Mutable.Linear.WitnessSpec

  hs-source-dirs: test
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -O2

  build-tool-depends: tasty-discover:tasty-discover
  build-depends:
    base >=4.7 && <5,
    containers,
    dlist,
    falsify,
    foldl,
    linear-base,
    linear-witness,
    linear-witness-test-utils,
    tasty,
    tasty-hunit,
    vector,
