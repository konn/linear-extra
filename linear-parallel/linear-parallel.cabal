cabal-version: 3.4
name: linear-parallel
version: 0.1.0.0
synopsis: Parallel computation interfaces for Linear Haskell
description: Please see the README on GitHub at <https://github.com/konn/linear-parallel#readme>
category: Control
homepage: https://github.com/konn/linear-parallel#readme
bug-reports: https://github.com/konn/linear-parallel/issues
author: Hiromi ISHII
maintainer: konn.jinro_at_gmail.com
copyright: 2023 (c) Hiromi ISHII
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
extra-source-files:
  CHANGELOG.md
  README.md

tested-with:
  ghc ==9.8.4
  ghc ==9.10.2
  ghc ==9.12.2

source-repository head
  type: git
  location: https://github.com/konn/linear-parallel

common defaults
  other-modules: Paths_linear_parallel
  autogen-modules: Paths_linear_parallel
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

  default-language: Haskell2010

library
  import: defaults
  hs-source-dirs: src
  -- cabal-gild: discover src --exclude=src/**/Internal.hs
  exposed-modules:
    Control.Parallel.Linear
    Control.Parallel.Strategy.Linear

  -- cabal-gild: discover src --include=src/**/Internal.hs
  other-modules:
  build-depends:
    base >=4.7 && <5,
    linear-array-extra,
    linear-base,
    linear-generics,
    linear-witness,

test-suite linear-parallel-test
  import: defaults
  type: exitcode-stdio-1.0
  main-is: Main.hs
  -- cabal-gild: discover test --exclude=test/Main.hs
  other-modules:
  hs-source-dirs: test
  ghc-options:
    -threaded
    -rtsopts
    -O2
    -with-rtsopts=-N

  build-depends:
    base >=4.7 && <5,
    linear-array-extra,
    linear-base,
    linear-generics,
    linear-parallel,
    linear-witness,
