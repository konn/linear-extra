cabal-version: 3.4
name: linear-memory
version: 0.1.0.0
description: Please see the README on GitHub at <https://github.com/konn/linear-memory#readme>
homepage: https://github.com/konn/linear-memory#readme
bug-reports: https://github.com/konn/linear-memory/issues
author: Hiromi ISHII
maintainer: konn.jinro_at_gmail.com
copyright: 2023 (c) Hiromi ISHII
license: BSD-3-Clause
license-file: LICENSE
build-type: Simple
extra-source-files:
  CHANGELOG.md
  README.md

source-repository head
  type: git
  location: https://github.com/konn/linear-memory

common defaults
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wmissing-home-modules
    -Wpartial-fields
    -Wredundant-constraints

  other-modules: Paths_linear_memory
  autogen-modules: Paths_linear_memory
  default-language: GHC2021

library
  import: defaults
  hs-source-dirs: src
  -- cabal-gild: discover src --exclude=src/**/Internal.hs
  exposed-modules:
    Data.AtomicCounter.Linear
    Data.Ref.Linear.ReferenceCount.Borrowable.ThreadUnsafe
    Foreign.Marshal.Pure.Extra

  -- cabal-gild: discover src --include=src/**/Internal.hs
  other-modules: Foreign.Atomic.Internal
  c-sources: cbits/atomic.c
  build-depends:
    base >=4.7 && <5,
    bytestring,
    derive-storable,
    derive-storable-plugin,
    focus,
    hashable,
    linear-array-extra,
    linear-base,
    linear-witness,
    stm,
    vector,

test-suite linear-memory-test
  import: defaults
  type: exitcode-stdio-1.0
  main-is: Main.hs
  -- cabal-gild: discover test --exclude=test/Main.hs
  other-modules:
    Data.AtomicCounter.LinearSpec
    Foreign.Marshal.Pure.ExtraSpec

  hs-source-dirs: test
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

  build-tool-depends: tasty-discover:tasty-discover
  build-depends:
    base >=4.7 && <5,
    bytestring,
    falsify,
    linear-array-extra,
    linear-base,
    linear-memory,
    linear-parallel,
    linear-witness,
    linear-witness-test-utils,
    tasty,
    tasty-hunit,
    vector,
